# ============================================================================
# Olivia Saunders Photography — environment configuration
# Copy to `.env` for local development and fill in the values.
# NEVER commit a real `.env`. Production values belong in your host's secret store.
# ============================================================================

# ----------------------------------------------------------------------------
# Core application
# ----------------------------------------------------------------------------
# Public base URL of the site (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Used by Auth.js. Generate with: `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-long-random-string"
# Trust the host header (required on Vercel / behind a proxy).
AUTH_TRUST_HOST="true"

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# Local: docker compose service, Supabase, or Neon.
# Neon/Supabase require sslmode=require. Use the pooled URL for the app and the
# direct URL for migrations.
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/olivia_saunders?schema=public"
# Optional direct (non-pooled) connection used by `prisma migrate`.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/olivia_saunders?schema=public"

# ----------------------------------------------------------------------------
# Object storage
# STORAGE_DRIVER: "local" (dev fallback) | "s3" (AWS S3, Cloudflare R2, MinIO)
# ----------------------------------------------------------------------------
STORAGE_DRIVER="local"

# Root directory used by the local storage driver (relative to project root).
LOCAL_STORAGE_DIR="./storage"

# --- S3 / R2 / MinIO (used when STORAGE_DRIVER="s3") ---
# For AWS S3 leave S3_ENDPOINT blank. For R2/MinIO set the endpoint explicitly.
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Private bucket for client galleries and originals (NOT publicly readable).
S3_PRIVATE_BUCKET="olivia-private"
# Bucket for public portfolio display assets (may be CDN-fronted).
S3_PUBLIC_BUCKET="olivia-public"
# Set true for MinIO / some S3-compatible providers that require path-style URLs.
S3_FORCE_PATH_STYLE="false"
# Optional public CDN base URL for the public bucket (e.g. https://cdn.example.com).
S3_PUBLIC_BASE_URL=""

# How long signed view/download URLs remain valid (seconds).
SIGNED_URL_TTL_SECONDS="300"

# ----------------------------------------------------------------------------
# Email (transactional)
# EMAIL_DRIVER: "console" (dev — logs to server console) | "resend" | "smtp-noop"
# ----------------------------------------------------------------------------
EMAIL_DRIVER="console"
EMAIL_FROM="Olivia Saunders <studio@example.com>"
# Where new-enquiry notifications are sent.
ADMIN_NOTIFICATION_EMAIL="studio@example.com"
# Resend API key (used when EMAIL_DRIVER="resend").
RESEND_API_KEY=""

# ----------------------------------------------------------------------------
# Rate limiting
# In-memory limiter is used by default. For multi-instance production, wire an
# external store (e.g. Upstash Redis) via these variables (see README).
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED="true"

# ----------------------------------------------------------------------------
# Optional: privacy-conscious analytics (disabled unless configured)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_DRIVER=""       # "" | "plausible"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ----------------------------------------------------------------------------
# Optional: error monitoring (disabled unless configured)
# ----------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ----------------------------------------------------------------------------
# Seed data (development only) — used by prisma/seed.ts
# ----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!Admin123"
SEED_CLIENT_PASSWORD="ChangeMe!Client123"
